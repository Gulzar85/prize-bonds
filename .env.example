# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database
DATABASE_URL=postgres://prizebonds:prizebonds@localhost:5432/prizebonds

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Email (dictionary-based config for Django 6.1)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@prizebonds.local

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Security
SECURE_SSL_REDIRECT=False
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# JWT (RS256 PEM; use \n for newlines when set on one line)
JWT_PRIVATE_KEY=
ADMIN_REQUIRE_MFA=True
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# Axes
AXES_ENABLED=True
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1

# Site
SITE_ID=1
FRONTEND_URL=http://localhost:3000

# Draw engine (Phase 1)
DRAWS_CONTACT_EMAIL=gulzar85@hotmail.com
DRAWS_MIN_REQUEST_INTERVAL=2.0
DRAWS_FOUR_EYES=False
DRAWS_AUTO_APPROVE_CLEAN_BACKFILL=True
DRAWS_HISTORICAL_AFTER_DAYS=30
# Production raw-file storage (private S3-compatible bucket); leave empty in development.
DRAWS_S3_BUCKET=
DRAWS_S3_ENDPOINT_URL=
DRAWS_S3_ACCESS_KEY=
DRAWS_S3_SECRET_KEY=
